const productosContainer = document.getElementById("productos");
const menuCategorias = document.getElementById("menuCategorias");
const detalle = document.getElementById("detalle");
const menu = document.getElementById("menu");
const buscador = document.getElementById("buscador");
const sinResultados = document.getElementById("sinResultados");
const limpiarFiltros = document.getElementById("limpiarFiltros");

let filtroCategoriaActivo = "";
let botonesFiltro = [];

renderizarCatalogo();
renderizarMenu();
registrarEventosBase();
aplicarFiltros();

window.addEventListener("load", () => {
    document.body.classList.add("page-ready");
});

function renderizarCatalogo() {
    productosContainer.innerHTML = "";

    const fragmento = document.createDocumentFragment();

    Object.entries(catalogo).forEach(([clave, categoria]) => {
        const bloque = document.createElement("section");
        bloque.className = "categoria-bloque";
        bloque.dataset.group = clave;

        const header = document.createElement("div");
        header.className = "categoria-header";

        const info = document.createElement("div");
        const titulo = document.createElement("h3");
        titulo.textContent = categoria.label || "";

        const descripcion = document.createElement("p");
        descripcion.textContent = categoria.description || "";

        info.appendChild(titulo);
        info.appendChild(descripcion);

        const contador = document.createElement("span");
        contador.className = "chip";
        const totalItems = Array.isArray(categoria.items) ? categoria.items.length : 0;
        contador.textContent = `${totalItems} producto${totalItems !== 1 ? "s" : ""}`;

        header.appendChild(info);
        header.appendChild(contador);

        const grid = document.createElement("div");
        grid.className = "categoria-grid";

        (categoria.items || []).forEach((item) => {
            grid.appendChild(crearTarjeta(item, clave));
        });

        bloque.appendChild(header);
        bloque.appendChild(grid);
        fragmento.appendChild(bloque);
    });

    productosContainer.appendChild(fragmento);
}

function crearTarjeta(item, categoriaClave) {
    const card = document.createElement("article");
    card.className = "card";
    card.dataset.category = `${categoriaClave || ""} ${item.subcategoria || ""}`.trim();
    card.dataset.search = item.search || "";

    const imagen = document.createElement("img");
    imagen.src = item.image || "";
    imagen.alt = item.alt || item.nombre || "Producto";
    imagen.loading = "lazy";
    imagen.decoding = "async";

    const body = document.createElement("div");
    body.className = "card-body";

    const chip = document.createElement("span");
    chip.className = "chip";
    chip.textContent = item.chip || "";

    const nombre = document.createElement("h4");
    nombre.textContent = item.nombre || "";

    const precio = document.createElement("p");
    precio.className = "precio";
    precio.textContent = item.precio || "";

    const resumen = document.createElement("p");
    resumen.className = "resumen";
    resumen.textContent = item.resumen || "";

    const descripcion = document.createElement("span");
    descripcion.className = "desc";
    descripcion.textContent = item.descripcion || "";

    body.appendChild(chip);
    body.appendChild(nombre);
    body.appendChild(precio);
    body.appendChild(resumen);
    body.appendChild(descripcion);

    card.appendChild(imagen);
    card.appendChild(body);
    card.addEventListener("click", () => abrirDetalle(card));

    return card;
}

function renderizarMenu() {
    const bloques = Object.entries(catalogo).map(([clave, categoria]) => {
        const filtros = categoria.filters.map((filter) => `
            <button type="button" data-filter="${filter.value}">${filter.label}</button>
        `).join("");

        return `
            <div class="categoria">
                <button type="button" class="categoria-trigger" onclick="toggleSub(this)">
                    ${categoria.label}
                </button>
                <div class="sub" data-menu-group="${clave}">
                    ${filtros}
                </div>
            </div>
        `;
    });

    menuCategorias.innerHTML = bloques.join("");
    botonesFiltro = Array.from(document.querySelectorAll("[data-filter]"));

    botonesFiltro.forEach((boton) => {
        boton.addEventListener("click", () => {
            filtroCategoriaActivo = boton.dataset.filter || "";
            actualizarEstadoFiltros();
            aplicarFiltros();
            cerrarMenuSiAbierto();
        });
    });
}

function registrarEventosBase() {
    limpiarFiltros.addEventListener("click", () => {
        filtroCategoriaActivo = "";
        buscador.value = "";
        actualizarEstadoFiltros();
        aplicarFiltros();
        cerrarMenuSiAbierto();
    });

    buscador.addEventListener("input", aplicarFiltros);

    detalle.addEventListener("click", (event) => {
        if (event.target === detalle) {
            cerrarDetalle();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            cerrarDetalle();
            menu.classList.remove("active");
            menu.setAttribute("aria-hidden", "true");
        }
    });
}

function abrirDetalle(card) {
    document.getElementById("imgDetalle").src = card.querySelector("img").src;
    document.getElementById("tituloDetalle").textContent = card.querySelector("h4").textContent;
    document.getElementById("precioDetalle").textContent = card.querySelector(".precio").textContent;
    document.getElementById("descDetalle").textContent = card.querySelector(".desc").textContent;
    document.getElementById("categoriaDetalle").textContent = card.querySelector(".chip").textContent;

    detalle.style.display = "flex";
    detalle.setAttribute("aria-hidden", "false");
}

function cerrarDetalle() {
    detalle.style.display = "none";
    detalle.setAttribute("aria-hidden", "true");
}

function abrirMenu() {
    const abierto = menu.classList.toggle("active");
    menu.setAttribute("aria-hidden", abierto ? "false" : "true");
}

function toggleSub(el) {
    const sub = el.nextElementSibling;
    const estaAbierto = sub.style.display === "block";

    document.querySelectorAll(".sub").forEach((item) => {
        item.style.display = "none";
    });

    sub.style.display = estaAbierto ? "none" : "block";
}

function aplicarFiltros() {
    const cards = Array.from(document.querySelectorAll(".card"));
    const bloques = Array.from(document.querySelectorAll(".categoria-bloque"));
    const consulta = normalizarTexto(buscador.value);
    const terminos = expandirConsulta(consulta);
    let visibles = 0;

    cards.forEach((card) => {
        const textoVisible = normalizarTexto(card.textContent);
        const textoBusqueda = normalizarTexto(`${textoVisible} ${card.dataset.search || ""} ${card.dataset.category || ""}`);
        const categorias = card.dataset.category || "";
        const coincideTexto = evaluarCoincidencia(consulta, terminos, textoBusqueda);
        const coincideCategoria = !filtroCategoriaActivo || categorias.includes(filtroCategoriaActivo);
        const visible = coincideTexto && coincideCategoria;

        card.hidden = !visible;

        if (visible) {
            visibles += 1;
        }
    });

    bloques.forEach((bloque) => {
        const tieneVisible = bloque.querySelector(".card:not([hidden])");
        bloque.hidden = !tieneVisible;
    });

    sinResultados.hidden = visibles !== 0;
}

function expandirConsulta(consulta) {
    if (!consulta) {
        return [];
    }

    const palabras = obtenerTokens(consulta);

    const terminos = new Set(palabras);
    const consultaNormalizada = consulta.replace(/\s+/g, " ").trim();
    terminos.add(consultaNormalizada);

    palabras.forEach((palabra) => {
        const relacionados = sinonimos[palabra] || [];
        relacionados.forEach((item) => terminos.add(item));
    });

    if (consultaNormalizada.includes("pared") && consultaNormalizada.includes("gruesa")) {
        terminos.add("pared gruesa");
    }

    if (consultaNormalizada.includes("pared") && consultaNormalizada.includes("delgada")) {
        terminos.add("pared delgada");
    }

    if (consultaNormalizada.includes("contra") && consultaNormalizada.includes("tuerca")) {
        terminos.add("contra tuerca");
    }

    if (consultaNormalizada.includes("cal") && consultaNormalizada.includes("14")) {
        terminos.add("cal 14");
        terminos.add("calibre 14");
    }

    if ((consultaNormalizada.includes("cal") || consultaNormalizada.includes("calibre")) && consultaNormalizada.includes("2")) {
        terminos.add("cal 2");
        terminos.add("calibre 2");
        terminos.add("awg 2");
    }

    if (consultaNormalizada.includes("series") && consultaNormalizada.includes("7")) {
        terminos.add("series 7");
        terminos.add("serie 7");
    }

    if (consultaNormalizada.includes("series") && consultaNormalizada.includes("9")) {
        terminos.add("series 9");
        terminos.add("serie 9");
    }

    if (consultaNormalizada.includes("tipo") && consultaNormalizada.includes("t")) {
        terminos.add("tipo t");
    }

    return Array.from(terminos);
}

function evaluarCoincidencia(consulta, terminos, textoBusqueda) {
    if (!consulta) {
        return true;
    }

    if (textoBusqueda.includes(consulta)) {
        return true;
    }

    const tokensConsulta = obtenerTokens(consulta);

    const contieneTodosLosTokens = tokensConsulta.every((token) => {
        const relacionados = [token, ...(sinonimos[token] || [])];
        return relacionados.some((termino) => textoBusqueda.includes(normalizarTexto(termino)));
    });

    if (contieneTodosLosTokens) {
        return true;
    }

    const coincidencias = terminos.filter((termino) => textoBusqueda.includes(normalizarTexto(termino))).length;
    const minimoCoincidencias = Math.max(1, Math.min(tokensConsulta.length, 2));
    return coincidencias >= minimoCoincidencias;
}

function actualizarEstadoFiltros() {
    botonesFiltro.forEach((boton) => {
        boton.classList.toggle("active", boton.dataset.filter === filtroCategoriaActivo);
    });
}

function cerrarMenuSiAbierto() {
    menu.classList.remove("active");
    menu.setAttribute("aria-hidden", "true");
}

function normalizarTexto(texto) {
    return (texto || "")
        .toString()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[“”"]/g, " ")
        .replace(/[′']/g, " ")
        .replace(/[^\w\s/]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();
}

function obtenerTokens(texto) {
    return normalizarTexto(texto)
        .split(/\s+/)
        .map((token) => token.trim())
        .filter(Boolean);
}
